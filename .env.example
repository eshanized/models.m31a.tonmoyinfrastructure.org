# ==============================================================================
# NVIDIA Build Model Intelligence Platform Environment Variables
# Safe documentation template. Never place real secret values into this file.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="https://models.m31a.tonmoyinfrastructure.org"

# Database Persistence (PostgreSQL / Supabase compatible)
# When left unset or empty, the application operates in static catalog-only mode.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NVIDIA Build Synthetic Monitoring Credential
# Server-side dedicated credential for scheduled probe canary requests.
# NEVER expose this key to client-side bundles or public endpoints.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Internal Protected Ingestion Endpoint
# High-entropy shared secret used by the monitoring worker to post observations.
# Must be at least 16 characters. Verified using timingSafeEqual.
INGESTION_SECRET=""
INGESTION_URL="https://models.m31a.tonmoyinfrastructure.org/api/v1/ingest"

# Probe Worker Budget Controls
PROBE_PER_CYCLE_LIMIT="5"
PROBE_CONCURRENCY="2"
PROBE_TIMEOUT_MS="10000"
PROBE_MAX_RETRIES="2"
PROBE_KILL_SWITCH="false"
